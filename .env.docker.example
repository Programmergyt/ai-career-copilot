DEEPSEEK_API_KEY=your_deepseek_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key
LANGCHAIN_API_KEY=your_langchain_api_key

# Reuse the MySQL/Redis containers that are already published on the Ubuntu host.
# On Linux Docker hosts, host.docker.internal requires the compose extra_hosts entry.
# If that alias is unavailable on your server, replace it with 8.153.79.69.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=ai_career_copilot

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0

# Host ports exposed by this project.
BACKEND_PORT=8000
FRONTEND_PORT=3001
FASTAPI_WORKERS=2
